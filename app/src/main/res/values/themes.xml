<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 기본 테마 정의 -->
    <style name="Theme.Digital_Contest" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- 스플래시 화면 테마 -->
    <style name="Theme.Digital_Contest.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@dimen/splashscreen_icon_size</item>
        <item name="windowSplashScreenAnimationDuration">2000</item>
        <item name="postSplashScreenTheme">@style/Theme.Digital_Contest</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>
</resources>